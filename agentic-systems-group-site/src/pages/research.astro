---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Research & benchmarks — Agentic Systems Group";
const description = "Open projects from HumanDotPy: agent evaluation, model architecture research, and tools for training and inference workflows.";
---
<BaseLayout {title} {description}>
  <div class="page-shell">
  <section class="section">
    <div class="kicker">Program</div>
    <h1>Research &amp; benchmarks</h1>
    <p class="lead">
      Alongside Thoth, the open work includes environments for evaluating agents,
      model architecture experiments, and tools for recording training and inference runs.
      These projects are maintained by <a href="https://github.com/HumanDotPy">HumanDotPy</a>.
    </p>
  </section>

  <section class="section">
    <h2>Explore the code</h2>
    <ul>
      <li><a href="https://github.com/HumanDotPy/FactorioAgentBench"><strong>FactorioAgentBench</strong></a> — a persistent Factorio benchmark and agent evaluation platform.</li>
      <li><a href="https://github.com/HumanDotPy/ArchitectureResearchBench"><strong>ArchitectureResearchBench</strong></a> — an environment for model architecture research.</li>
      <li><a href="https://github.com/HumanDotPy/RolloutPlane"><strong>RolloutPlane</strong></a> — a control plane and evidence ledger for agentic reinforcement learning.</li>
      <li><a href="https://github.com/HumanDotPy/GradientFoundry"><strong>GradientFoundry</strong></a> — an evidence platform for pretraining and post-training architecture research.</li>
    </ul>
  </section>
  </div>
</BaseLayout>
