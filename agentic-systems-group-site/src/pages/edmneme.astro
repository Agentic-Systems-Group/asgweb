---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "EdMneme — tutoring and project memory";
const description = "EdMneme is an interactive tutoring and project-memory system with a control room, inference routing, tool orchestration, and remote OCR.";
---
<BaseLayout {title} {description}>
  <div class="page-shell">
  <section class="section">
    <div class="kicker">Product</div>
    <h1>EdMneme</h1>
    <p class="lead">
      An interactive tutoring workspace for long-running learning projects—combining model routing, durable memory, textbook ingestion, and visible tool state in one control room.
    </p>
  </section>

  <section class="section">
    <h2>What it brings together</h2>
    <ul>
      <li><strong>Control room:</strong> Inspect projects, active sessions, model routing, and tool state without hiding the working process.</li>
      <li><strong>Durable project memory:</strong> Preserve learning goals, prior work, source context, and open questions across sessions.</li>
      <li><strong>Textbook ingestion:</strong> Bring long-form learning material into the workspace through document processing and remote OCR.</li>
      <li><strong>Inference routing:</strong> Match work to available local or remote models while keeping the operator in control.</li>
      <li><strong>Tool orchestration:</strong> Let tutoring sessions use bounded tools and visible project state instead of relying on one oversized prompt.</li>
    </ul>
  </section>

  <section class="section">
    <h2>Current status</h2>
    <p>EdMneme is under development and is not available for public download.</p>
  </section>

  <section class="section">
    <h2>Get access</h2>
    <p>Interested in the tutoring stack or a research collaboration? Reach out via <a href="/contact">Contact</a>.</p>
  </section>
  </div>
</BaseLayout>
