---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Contact — Agentic Systems Group";
const description = "How to reach the project and its maintainers.";
const sourceUrl = "https://github.com/HumanDotPy/ThothTerminal";
---
<BaseLayout {title} {description}>
  <div class="page-shell">
  <section class="section">
    <div class="kicker">Contact</div>
    <h1>Get in touch</h1>
    <p class="lead">Contact channels are still being set up. For now, the public repository is the best place to reach the project.</p>
    <p><a class="text-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">{sourceUrl} <span aria-hidden="true">↗</span></a></p>
    <p class="muted">No email or contact form is published yet. This page will be updated when a verified channel is available.</p>
  </section>
  </div>
</BaseLayout>
