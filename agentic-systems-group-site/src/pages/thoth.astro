---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Thoth Terminal — a workspace for your research";
const description = "Documents, datasets, notes, theses, and reports in a local-first workspace. Research with your sources and agents in one place.";
const sourceUrl = "https://github.com/HumanDotPy/ThothTerminal";
---
<BaseLayout {title} {description}>
  <article class="product-page">
    <header class="product-hero">
      <p class="eyebrow">Open-source · local-first</p>
      <h1>Thoth Terminal</h1>
      <p class="product-deck">Keep the thread of your research. Sources, data, notes, and conclusions belong together.</p>
      <div class="cta">
        <a class="button button-light" href={sourceUrl} target="_blank" rel="noopener noreferrer">View source</a>
        <a class="text-link text-link-light" href="#setup">Release status <span aria-hidden="true">↓</span></a>
      </div>
      <div class="product-rail" aria-label="Thoth Terminal workflow">
        <span>Sources</span><i></i><span>Evidence</span><i></i><span>Research</span><i></i><span>Briefings</span>
      </div>
    </header>

    <section class="editorial-section">
      <div class="section-index"><span>01</span><span>Why it exists</span></div>
      <div class="editorial-copy">
        <h2>A workspace you can return to.</h2>
        <p>Research builds over time: a document leads to a question, a dataset changes a view, and a note becomes part of a report. Thoth keeps that work connected. Your installation stores it in your own database and object store; you choose the sources, models, and services it connects to.</p>
      </div>
    </section>

    <section class="capability-ledger" aria-label="Thoth Terminal capabilities">
      <div><span>01</span><strong>Bring your sources</strong><p>RSS, public web sources, filings, browser-backed lists, documents, and manual capture.</p></div>
      <div><span>02</span><strong>Follow the evidence</strong><p>Connect observations, datasets, notes, and theses to their sources. Develop reports alongside the questions still open.</p></div>
      <div><span>03</span><strong>Use your models</strong><p>Run local models or bring provider keys. The system does not depend on one model vendor.</p></div>
      <div><span>04</span><strong>Continue with agents</strong><p>Desktop, web, and MCP tools share your research objects. Publish selected report versions when you choose.</p></div>
    </section>

    <section class="setup-section" id="setup">
      <div>
        <p class="eyebrow">Availability</p>
        <h2>The final beta is available.</h2>
        <p class="setup-note">Version 0.3.1-beta.1 is a source release for a fresh installation. It includes the application, required Rust crate, and setup instructions. You need Python, Rust/Cargo, and PostgreSQL. A prebuilt installer is not included.</p>
        <a class="text-link" href={`${sourceUrl}/releases/tag/v0.3.1-beta.1`} target="_blank" rel="noopener noreferrer">Get the final beta <span aria-hidden="true">↗</span></a>
      </div>
      <ol class="setup-steps">
        <li><span>1</span><div><strong>Install from source</strong><p>Follow the repository’s installation guide to build and run it locally.</p></div></li>
        <li><span>2</span><div><strong>Pick what you follow</strong><p>Start with public feeds, filings, documents, or a blank workspace.</p></div></li>
        <li><span>3</span><div><strong>Run a source check</strong><p>Thoth shows what connected, what needs credentials, and what stays optional.</p></div></li>
      </ol>
    </section>
  </article>
</BaseLayout>
