---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Zeta — a tactics RPG and simulation project";
const description = "A tactics RPG and simulation project in preproduction. No public build is available.";
---
<BaseLayout {title} {description}>
  <main class="page-shell">
    <section class="section">
      <p class="kicker">Preproduction</p>
      <h1>Zeta</h1>
      <p class="lead">A tactics RPG and simulation project exploring a shared set of world rules and structured actions for human and model-controlled characters.</p>
      <p>No public build is available. See the <a href="/research">research page</a> for projects you can try now.</p>
    </section>
  </main>
</BaseLayout>
