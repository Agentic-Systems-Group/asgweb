---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Agentic Systems Group — software for research and learning";
const description = "Independent software for research, learning, and agent evaluation. Home of Thoth Terminal, a local-first research workspace.";
const sourceUrl = "https://github.com/HumanDotPy/ThothTerminal";
---
<BaseLayout {title} {description}>
  <section class="hero hero-home">
    <div class="hero-signal" aria-hidden="true">
      <span class="signal-axis"></span>
      <span class="signal-line"></span>
      <span class="signal-point point-a"></span>
      <span class="signal-point point-b"></span>
      <span class="signal-point point-c"></span>
    </div>
    <div class="hero-content">
      <p class="eyebrow reveal reveal-1">Independent research &amp; systems engineering</p>
      <h1 class="display reveal reveal-2">Agentic<br />Systems Group</h1>
      <p class="hero-deck reveal reveal-3">Software for research and learning.</p>
      <div class="cta reveal reveal-4">
        <a class="button button-light" href="/thoth">Explore Thoth Terminal</a>
        <a class="text-link text-link-light" href="/research">Explore the projects <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-index" aria-hidden="true">
      <span>ASG / 001</span>
      <span>RESEARCH · MEMORY · VERIFICATION</span>
    </div>
  </section>

  <section class="feature feature-thoth">
    <div class="section-index">
      <span>01</span>
      <span>Thoth Terminal</span>
    </div>
    <div class="feature-copy">
      <p class="eyebrow">Thoth Terminal</p>
      <h2>Your research should stay yours.</h2>
      <p class="feature-lead">Collect sources, work with data, and develop a view. Thoth Terminal keeps documents, notes, theses, and reports together in a workspace you run yourself.</p>
      <div class="feature-actions">
        <a class="button" href="/thoth">See how it works</a>
        <a class="text-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="terminal-figure" aria-label="A diagram of Thoth Terminal's local-first research loop">
      <div class="terminal-top"><span>THOTH / WORKFLOW</span><span>ILLUSTRATION</span></div>
      <div class="terminal-body">
        <p><span>01</span> Connect the sources you trust</p>
        <p><span>02</span> Connect documents and data</p>
        <p><span>03</span> Keep conclusions with their sources</p>
        <p><span>04</span> Publish only what you choose</p>
      </div>
      <div class="terminal-foot">SOURCES → EVIDENCE → A WORKING VIEW</div>
    </div>
  </section>

  <section class="programs">
    <div class="section-index">
      <span>02</span>
      <span>Systems &amp; programs</span>
    </div>
    <div class="program-list">
      <a href="/edmneme" class="program-row">
        <span class="program-number">A</span>
        <span><strong>EdMneme</strong><small>Tutoring, OCR, and durable project memory</small></span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a href="/research" class="program-row">
        <span class="program-number">B</span>
        <span><strong>Research</strong><small>Retrieval, verification, and robust agents</small></span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
