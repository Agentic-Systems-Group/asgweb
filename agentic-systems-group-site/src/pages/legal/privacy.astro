---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = true;
const title = "Privacy — Agentic Systems Group";
const description = "Our approach to privacy and data handling.";
---
<BaseLayout {title} {description}>
  <div class="page-shell legal-page">
  <section class="section">
    <h1>Privacy</h1>
    <p class="lead">This is a static website with no accounts or forms. We do not add advertising or analytics scripts to the site.</p>
    <h2>What we process</h2>
    <ul>
      <li>Our hosting provider processes network requests and may retain request metadata or use security cookies for reliability and abuse prevention.</li>
    </ul>
    <h2>No accounts, no newsletter</h2>
    <p>There is currently no newsletter, subscription list, or user account system. If that changes, this page will be updated before any collection begins.</p>
  </section>
  </div>
</BaseLayout>
